<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.ChatAnonymizer" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Cores Principais -->
        <item name="colorPrimary">@color/wa_green_light_accent</item>
        <item name="colorOnPrimary">@color/wa_bg_dark</item>
        <item name="colorSecondaryContainer">@color/wa_green_light_accent</item>
        <item name="colorOnSecondaryContainer">@color/wa_bg_dark</item>

        <!-- Superfícies -->
        <item name="colorSurface">@color/wa_surface_dark</item>
        <item name="colorOnSurface">@color/wa_on_surface_dark</item>
        <item name="colorSurfaceVariant">@color/wa_bg_dark</item>
        <item name="colorOnSurfaceVariant">@color/grey_text_dark</item>

        <!-- Fundo -->
        <item name="android:windowBackground">@color/wa_bg_dark</item>

        <!-- Textos Secundários -->
        <item name="colorOutline">@color/grey_text_dark</item>

        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/ic_background</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/ic_launcher_foreground</item>

        <item name="android:windowLightStatusBar">false</item>
        <!-- Garante que a barra de status fique escura no modo dark -->
        <item name="android:statusBarColor">@color/wa_bg_dark</item>

        <!-- Tipografia Global (Material 3) -->
        <item name="textAppearanceHeadlineSmall">@style/AppHeadlineSmall</item>
        <item name="textAppearanceTitleMedium">@style/AppTitleMedium</item>
        <item name="textAppearanceBodyLarge">@style/AppBodyLarge</item>
        <item name="textAppearanceLabelMedium">@style/AppLabelMedium</item>

        <!-- Estilos Globais de Componentes -->
        <item name="materialCardViewStyle">@style/Widget.App.CardView</item>
        <item name="materialSwitchStyle">@style/Widget.App.Switch</item>
        <item name="materialButtonStyle">@style/botaoCustomizado</item>

    </style>
</resources>
